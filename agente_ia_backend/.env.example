ORACLE_HOST=192.168.15.X
ORACLE_PORT=1521
ORACLE_SERVICE=nombre_servicio
ORACLE_USER=usuario_oracle
ORACLE_PASSWORD=contraseña_oracle

# Ruta a Oracle Instant Client para thick mode (requerido por hashes 11g)
# Linux / Docker:  ORACLE_CLIENT_DIR=/opt/oracle/instantclient
# Windows:         ORACLE_CLIENT_DIR=C:\app\client\product\12.2.0\client_1
# Thin mode:       dejar vacío (solo si el servidor tiene SHA-256 verifiers)
ORACLE_CLIENT_DIR=/opt/oracle/instantclient

ANTHROPIC_API_KEY=sk-ant-api03-...
LLM_MODEL=claude-haiku-4-5-20251001

LOG_LEVEL=INFO
MAX_ROWS=50
DB_CALL_TIMEOUT_MS=8000
